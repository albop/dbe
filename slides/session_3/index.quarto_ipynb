        "\n",
        "\n",
        "## Quick look\n",
        "\n",
        "Using [matplotlib](https://matplotlib.org/) (3d)\n"
      ],
      "id": "b5e46bd9"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "fig = plt.figure(figsize=(10,10))\n",
        "ax = fig.add_subplot(projection='3d')\n",
        "\n",
